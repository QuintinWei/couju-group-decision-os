# 服务端 AI 反馈总结与结果解释。默认直连 DeepSeek 官方，也兼容 OpenAI-compatible 地址。
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000

# 高德开放平台「Web 服务 API」类型 Key，用于十城地点检索和地理编码。
AMAP_WEB_SERVICE_KEY=

# 微信小程序服务端登录。App Secret 与令牌签名密钥仅限服务端环境变量。
WECHAT_APP_ID=wx7162630074a237b6
WECHAT_APP_SECRET=
WECHAT_TOKEN_SECRET=

# 小程序构建时写入的公开 API 地址；仅配置服务域名，绝不放入服务端密钥。
TARO_APP_API_BASE=
